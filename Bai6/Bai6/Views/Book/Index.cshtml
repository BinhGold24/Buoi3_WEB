@model IEnumerable<Bai6Validation.Models.Book>

@{
    ViewData["Title"] = "Danh sách sách";
}

<h2>Danh sách sách hiện có</h2>

<a asp-action="Create" style="display:inline-block; margin-bottom: 15px; padding: 6px 12px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px;">+ Đến trang thêm sách</a>

<table border="1" cellpadding="10" style="width: 100%; border-collapse: collapse; text-align: left;">
    <thead>
        <tr style="background-color: #f8f9fa;">
            <th>Mã sách (Id)</th>
            <th>Tên sách (Name)</th>
            <th>Giá tiền (Price)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>$@item.Price</td>
            </tr>
        }
    </tbody>
</table>