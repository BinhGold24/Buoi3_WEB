@model Bai6Validation.Models.Book

@{
    ViewData["Title"] = "Thêm sách - Validation";
}

<h2>Thêm sách mới (Kiểm tra dữ liệu)</h2>

@if (ViewBag.Message != null)
{
    <div style="padding: 10px; margin-bottom: 15px; color: white; background-color: #28a745; border-radius: 4px; width: 300px;">
        @ViewBag.Message
    </div>
}

<form asp-action="Create" method="post" style="border: 1px solid #ccc; padding: 20px; width: 300px; border-radius: 4px;">

    <div style="margin-bottom: 15px;">
        <label>Tên sách (Name):</label><br />
        <input type="text" asp-for="Name" style="width: 100%; padding: 6px; box-sizing: border-box;" />

        <span asp-validation-for="Name" style="color: red; font-size: 14px; display: block; margin-top: 5px;"></span>
    </div>

    <div style="margin-bottom: 20px;">
        <label>Giá (Price):</label><br />
        <input type="number" step="0.01" asp-for="Price" style="width: 100%; padding: 6px; box-sizing: border-box;" />

        <span asp-validation-for="Price" style="color: red; font-size: 14px; display: block; margin-top: 5px;"></span>
    </div>

    <button type="submit" style="padding: 7px 15px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer;">Thêm vào thư viện</button>
</form>

<br />
<a asp-action="Index" style="color: #007bff; text-decoration: none;">⬅ Xem danh sách sách</a>