@model Buoi5.Models.Book

@{
    ViewData["Title"] = "Thêm sách mới";
}

<h2>Thêm sách mới vào hệ thống</h2>

@if (ViewBag.Message != null)
{
    <div style="padding: 10px; margin-bottom: 15px; color: white; background-color: #28a745; border-radius: 4px; width: 300px;">
        @ViewBag.Message
    </div>
}

<form asp-action="Create" method="post" style="border: 1px solid #ccc; padding: 20px; width: 300px; border-radius: 4px;">
    <div style="margin-bottom: 12px;">
        <label>Tên sách (Name):</label><br />
        <input type="text" asp-for="Name" style="width: 100%; padding: 6px; box-sizing: border-box;" required />
    </div>

    <div style="margin-bottom: 18px;">
        <label>Giá (Price):</label><br />
        <input type="number" step="0.01" asp-for="Price" style="width: 100%; padding: 6px; box-sizing: border-box;" required />
    </div>

    <button type="submit" style="padding: 7px 15px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer;">Thêm vào thư viện</button>
</form>

<br />
<a asp-action="Index" style="color: #007bff; text-decoration: none;">⬅ Quay lại danh sách</a>