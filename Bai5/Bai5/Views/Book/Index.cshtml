@model IEnumerable<Buoi5.Models.Book>

@{
    ViewData["Title"] = "Danh sách sách";
}

<h2>Book Management</h2>

<a asp-action="Create" style="display:inline-block; margin-bottom: 15px; padding: 6px 12px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px;">+ Thêm sách mới</a>

<table class="table" border="1" cellpadding="10" style="width: 100%; border-collapse: collapse; text-align: left;">
    <thead>
        <tr style="background-color: #f8f9fa;">
            <th>Id</th>
            <th>Name</th>
            <th>Price ($)</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>
                    <a asp-action="Detail" asp-route-id="@item.Id" style="color: #007bff; text-decoration: none;">Xem chi tiết</a>
                </td>
            </tr>
        }
    </tbody>
</table>